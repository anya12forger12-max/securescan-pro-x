#!/usr/bin/env bash
# =============================================================================
# Malware Hash Checker Pro - Git Pre-Commit Hook
# Runs linting, format checks, import validation, and trailing whitespace checks
# before allowing a commit.
# =============================================================================
set -euo pipefail

# -- Colors -------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

info()  { printf "${YELLOW}[HOOK]${NC} %s\n" "$*"; }
pass()  { printf "${GREEN}[PASS]${NC} %s\n" "$*"; }
error() { printf "${RED}[FAIL]${NC} %s\n" "$*" >&2; }

# -- Repo Root ----------------------------------------------------------------
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

FAILED=0

# -- Get Staged Files --------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
STAGED_COUNT=$(echo "$STAGED_FILES" | grep -c . || echo "0")

if [[ "$STAGED_COUNT" -eq 0 ]]; then
    info "No staged Python files. Skipping checks."
    exit 0
fi

info "Checking ${STAGED_COUNT} staged Python file(s)..."

# -- 1. Trailing Whitespace --------------------------------------------------
info "Checking trailing whitespace..."
WHITESPACE_FAIL=0
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if [[ -f "$file" ]] && grep -Pn '\s+$' "$file" >/dev/null 2>&1; then
        error "Trailing whitespace in: ${file}"
        WHITESPACE_FAIL=1
    fi
done <<< "$STAGED_FILES"

if [[ "$WHITESPACE_FAIL" -eq 0 ]]; then
    pass "No trailing whitespace"
else
    FAILED=1
fi

# -- 2. Ruff Check -----------------------------------------------------------
info "Running ruff lint check..."
if command -v ruff &>/dev/null; then
    # Only check staged files
    STAGED_PY_ARRAY=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && STAGED_PY_ARRAY+=("$f")
    done <<< "$STAGED_FILES"

    if ruff check "${STAGED_PY_ARRAY[@]}" 2>/dev/null; then
        pass "Ruff lint: clean"
    else
        error "Ruff lint found issues (fix before committing)"
        FAILED=1
    fi
else
    info "ruff not found, skipping lint check"
fi

# -- 3. Black Format Check ---------------------------------------------------
info "Running black format check..."
if command -v black &>/dev/null; then
    STAGED_PY_ARRAY=()
    while IFS= read -r f; do
        [[ -n "$f" ]] && STAGED_PY_ARRAY+=("$f")
    done <<< "$STAGED_FILES"

    if black --check "${STAGED_PY_ARRAY[@]}" 2>/dev/null; then
        pass "Black format: clean"
    else
        error "Black formatting issues (run: black <files>)"
        FAILED=1
    fi
else
    info "black not found, skipping format check"
fi

# -- 4. Basic Import Validation ----------------------------------------------
info "Checking import validity..."
IMPORT_FAIL=0
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    [[ ! -f "$file" ]] && continue

    # Check for common import mistakes: bare except, star imports from non-stdlib
    if grep -nE 'from\s+\S+\s+import\s+\*' "$file" 2>/dev/null | grep -v '# noqa' >/dev/null 2>&1; then
        error "Wildcard import found in: ${file}"
        IMPORT_FAIL=1
    fi
done <<< "$STAGED_FILES"

if [[ "$IMPORT_FAIL" -eq 0 ]]; then
    pass "Import validation: clean"
else
    FAILED=1
fi

# -- Summary ------------------------------------------------------------------
echo ""
if [[ "$FAILED" -ne 0 ]]; then
    error "Pre-commit checks FAILED. Fix issues before committing."
    error "To bypass (not recommended): git commit --no-verify"
    exit 1
else
    pass "All pre-commit checks passed."
    exit 0
fi
