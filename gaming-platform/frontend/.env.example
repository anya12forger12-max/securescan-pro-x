# Build-time origin of the gateway. Leave blank in Docker/Compose: the client
# is served by the gateway itself, so /v1 and /v1/events/stream are same-origin.
# For `npm start` on CRA's port 4000, the package.json proxy forwards /v1 to
# http://localhost:3000, so this can stay blank there too.
REACT_APP_API_URL=
REACT_APP_DEBUG=false
# Comma-separated parent origins allowed to drive the embedded game through
# postMessage. Same-origin is always allowed; leave blank for a standalone app.
# Example: REACT_APP_OPERATOR_ORIGINS=https://operator.example.com
REACT_APP_OPERATOR_ORIGINS=
