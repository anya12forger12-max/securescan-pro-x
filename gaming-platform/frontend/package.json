{
  "name": "gp-gaming-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Gaming platform browser client - Aviator-style CRA/context architecture",
  "proxy": "http://localhost:3000",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.6",
    "react-toastify": "^9.1.2"
  },
  "scripts": {
    "start": "cross-env PORT=4000 react-app-rewired start",
    "build": "cross-env GENERATE_SOURCEMAP=false react-app-rewired build",
    "test": "react-scripts test --watchAll=false",
    "typecheck": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "assert": "^2.0.0",
    "browserify-assets": "^1.6.1",
    "browserify-zlib": "^0.2.0",
    "cross-env": "^7.0.3",
    "crypto-browserify": "^3.12.0",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "5.0.1",
    "sass": "^1.59.3",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "typescript": "^5.0.4",
    "url": "^0.11.0",
    "util": "^0.12.5",
    "webpack": "^5.79.0"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "uglify-js": "2.8.29",
    "bfj": "9.1.4",
    "jsonpath": "1.3.0",
    "underscore": "1.13.8",
    "qs": "6.17.1",
    "uuid": "11.1.1",
    "serialize-javascript": "7.1.4",
    "postcss": "8.5.33",
    "browserify": "17.0.1",
    "svgo": "4.1.0",
    "css-select": "7.0.0",
    "nth-check": "3.0.1",
    "glob": "14.0.6",
    "minimatch": "11.0.9",
    "webpack-dev-middleware": "7.4.5",
    "webpack-dev-server": "6.1.0",
    "http-proxy-agent": "7.0.2",
    "@tootallnate/once": "2.0.1",
    "react-router": "7.18.6"
  }
}