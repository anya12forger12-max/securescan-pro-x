# Generate a safe .env with: npm run env:init
# Every blank value below is required by docker compose and intentionally has
# no default, so a deployment cannot start with a known development secret.
# The values in this file are placeholders only — never deploy them.

NODE_ENV=production
POSTGRES_USER=gp
POSTGRES_PASSWORD=
POSTGRES_DB=gaming_platform
DATABASE_URL=
# Per-service Postgres pool size; keep 15 * DB_POOL_MAX below max_connections.
DB_POOL_MAX=5
# Redis requires a password and is not published on the host. REDIS_URL must
# embed the same REDIS_PASSWORD (percent-encoded if it contains reserved chars).
REDIS_PASSWORD=
REDIS_URL=
JWT_ACCESS_SECRET=
SERVICE_TOKEN=
# Capability-scoped internal credentials; generate distinct values.
ADMIN_SERVICE_TOKEN=
# Full wallet capability: gateway/test/admin only. Peer services get scoped
# tokens: promotions -> bonus credits, crash -> debits and win credits.
WALLET_SERVICE_TOKEN=
WALLET_DEBIT_SERVICE_TOKEN=
WALLET_BONUS_SERVICE_TOKEN=
WALLET_WIN_SERVICE_TOKEN=
REALTIME_SERVICE_TOKEN=
PROMOTIONS_SERVICE_TOKEN=
CRASH_SERVICE_TOKEN=
# One-time secret used only to claim the first admin role.
ADMIN_BOOTSTRAP_TOKEN=
# Exact browser origin (scheme://host[:port]), https:// in production.
CORS_ORIGIN=
LOG_LEVEL=info
# Gateway abuse controls. Auth routes are limited per IP; player reads/writes
# and event streams are limited per verified user. RATE_LIMIT_FAIL_CLOSED=true
# rejects traffic when Redis is unavailable instead of weakening the limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_USER_MAX=120
RATE_LIMIT_MUTATE_MAX=30
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_STREAM_MAX=20
MAX_STREAMS=500
EVENT_RETENTION_HOURS=168
