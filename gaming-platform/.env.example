# Generate a safe .env with: npm run env:init
# Every blank value below is required by docker compose and intentionally has
# no default, so a deployment cannot start with a known development secret.

NODE_ENV=production
POSTGRES_USER=gp
POSTGRES_PASSWORD=
POSTGRES_DB=gaming_platform
DATABASE_URL=
# Per-service Postgres pool size; keep 13 * DB_POOL_MAX below max_connections.
DB_POOL_MAX=5
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=
SERVICE_TOKEN=
CORS_ORIGIN=
LOG_LEVEL=info
