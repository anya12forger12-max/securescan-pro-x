# Optional: override the SecureScan Pro X data directory (defaults to ~/.securescan)
SECURESCAN_HOME=

# The gaming-platform stack uses its own generated secrets file.
# Run: CORS_ORIGIN=https://play.example.com npm run env:init --prefix gaming-platform
# See gaming-platform/.env.example for the variables it generates.

# ============================================================
# Production deployment (docker/compose/docker-compose.prod.yml)
# ============================================================
# Copy this file to .env (gitignored) and replace only what you need.
# These are example values, not secrets; never commit a populated .env.

# API base URL baked into the frontend at *build* time.
#   /api/v1                       -> same-origin nginx proxy to the backend
#   https://api.example.com/api/v1 -> external backend (must be CORS-allowed)
VITE_API_URL=/api/v1

# Host ports published by the production Compose stack.
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Container-side backend settings (Compose sets SECURESCAN_HOME=/data on the
# named volume; the SECURESCAN_HOME key above is for native/desktop runs).
# SECURESCAN_DEBUG=false
# SECURESCAN_LOGGING__LEVEL=info
